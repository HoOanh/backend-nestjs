# Google Gemini AI Tutor API Key (Serverless Functions)
GEMINI_API_KEY=your_gemini_api_key

# Optional remote ZeroTTS endpoint for non-Vercel deployments.
# Vercel runs the Python Function in api/zerotts.py directly.
ZEROTTS_URL=
ZEROTTS_API_KEY=

# Admin credentials
ADMIN_EMAIL=admin@arc-irobot.tech
ADMIN_PASSWORD=your_admin_password

# Google OAuth 2.0 Client ID (Frontend Vite build)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Required on production: random private secret, at least 32 characters.
JWT_SECRET=

# Optional persistent-volume store path (single-process hosting only).
# This is not a shared multi-instance database.
ARC_STORE_PATH=
