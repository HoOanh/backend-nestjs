# Google Gemini AI Tutor API Key (Serverless Functions)
GEMINI_API_KEY=your_gemini_api_key

# Server-side ZeroTTS proxy target; keep this URL out of frontend VITE variables.
ZEROTTS_URL=
ZEROTTS_API_KEY=
# Set true after the Cloud Run service and Vercel proxy are configured.
# true = use the remote ZeroTTS API; false = run the real ZeroTTS model in the browser.
VITE_ZEROTTS_ENABLED=false

# Admin credentials
ADMIN_EMAIL=admin@arc-irobot.tech
ADMIN_PASSWORD=your_admin_password

# Google OAuth 2.0 Client ID (Frontend Vite build)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Required on production: random private secret, at least 32 characters.
JWT_SECRET=

# Optional persistent-volume store path (single-process hosting only).
# This is not a shared multi-instance database.
ARC_STORE_PATH=
