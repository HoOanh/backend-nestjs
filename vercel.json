{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/tutor.js": {
      "maxDuration": 30
    },
    "api/index.js": {
      "maxDuration": 15
    }
  },
  "routes": [
    { "src": "/api/tutor", "dest": "/api/tutor.js" },
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
