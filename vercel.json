{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/tutor.js": {
      "maxDuration": 30
    },
    "api/tts.js": {
      "maxDuration": 60
    },
    "api/tts-stream.js": {
      "maxDuration": 60
    },
    "api/zerotts.py": {
      "maxDuration": 300,
      "excludeFiles": "node_modules/**"
    },
    "api/index.js": {
      "maxDuration": 15
    }
  },
  "routes": [
    { "src": "/api/tts/stream", "dest": "/api/zerotts.py?mode=stream" },
    { "src": "/api/tts", "dest": "/api/zerotts.py?mode=wav" },
    { "src": "/api/tutor", "dest": "/api/tutor.js" },
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
